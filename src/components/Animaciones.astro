---
/**
 * Entradas suaves al aparecer en pantalla. Script mínimo, inline en el <head>.
 * Los elementos con data-reveal se ocultan por CSS solo si este script marcó <html class="anim">;
 * sin JS o con prefers-reduced-motion, el contenido se ve siempre.
 */
---

<script is:inline>
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('anim');
    addEventListener('DOMContentLoaded', function () {
      var o = new IntersectionObserver(
        function (l) {
          l.forEach(function (x) {
            if (x.isIntersecting) {
              x.target.classList.add('visto');
              o.unobserve(x.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach(function (el) { o.observe(el); });
    });
  })();
</script>
