---
/**
 * Riel fijo de escritorio + el panel de categorías que se despliega desde la izquierda, con
 * columnas en cascada para las subcategorías (ver CLAUDE.md, tanda 1 de la revisión de
 * diseño — pixel a pixel contra .scratch/revision/01-menu lateral desktop.png y
 * "01- Captura de pantalla 2026-09-30 151035.png"). El botón "Categorías" del encabezado
 * abre este mismo panel (ver src/scripts/panel-categorias.ts, iniciarPanelCategorias()).
 * Todo en un solo componente/wrapper: el riel, el panel y las tarjetas en cascada tienen que
 * ser descendientes del mismo contenedor para que un solo mouseleave sepa cuándo cerrar.
 */
import { obtenerTodasLasCategorias, obtenerIconosCategorias, categoriasConStock, arbolCategoriasConStock, ordenarPrincipales } from '../lib/tienda/categorias';
import { obtenerProductosEnStock } from '../lib/tienda/productos';

const [categorias, productosEnStock, iconos] = await Promise.all([
  obtenerTodasLasCategorias(),
  obtenerProductosEnStock(),
  obtenerIconosCategorias(),
]);
const principales = ordenarPrincipales(categorias.filter((c) => c.parent === 0));
const conStock = categoriasConStock(categorias, productosEnStock);
const arbol = arbolCategoriasConStock(categorias, principales, conStock, iconos);
---

<div data-sistema-categorias>
  <aside aria-label="Categorías" data-riel class="fixed inset-y-0 left-0 z-20 hidden w-16 flex-col items-center border-r border-borde bg-fondo py-3 lg:flex">
    <button type="button" data-abrir-panel-categorias aria-label="Categorías" aria-haspopup="true" aria-expanded="false" class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-primario text-sobre-primario shadow-sm">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    {
      arbol.map((cat) => (
        <a href={cat.ruta} title={cat.nombre} data-fila-raiz data-id={cat.id} class="flex h-14 w-16 items-center justify-center text-texto hover:text-primario-oscuro">
          {cat.icono ? <img src={cat.icono} alt={cat.nombre} width="24" height="24" loading="lazy" class="h-6 w-6 object-contain" /> : <span class="sr-only">{cat.nombre}</span>}
        </a>
      ))
    }
  </aside>

  <div data-overlay-categorias hidden class="fixed inset-0 z-30 bg-black/40 opacity-0 transition-opacity duration-200"></div>

  <aside data-panel-categorias hidden aria-label="Categorías" class="fixed inset-y-0 left-0 z-40 w-[280px] -translate-x-full bg-fondo shadow-xl transition-transform duration-200">
    <div class="flex h-full flex-col overflow-y-auto p-3">
      <button type="button" data-abrir-panel-categorias class="boton flex w-full items-center justify-center gap-2 rounded-full">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        Menú
      </button>

      <ul data-lista-categorias class="mt-2" data-nivel="0">
        {
          arbol.map((cat) => (
            <li>
              <a href={cat.ruta} data-fila-panel data-id={cat.id} class="flex h-11 items-center gap-3 rounded-lg px-2 text-[15px] font-medium hover:bg-fondo-suave">
                {cat.icono ? <img src={cat.icono} alt="" width="20" height="20" loading="lazy" class="h-5 w-5 shrink-0 object-contain" /> : <span class="h-5 w-5 shrink-0" />}
                <span class="min-w-0 flex-1 truncate">{cat.nombre}</span>
                {cat.hijos.length > 0 && (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-texto-suave" aria-hidden="true" focusable="false">
                    <path d="m9 6 6 6-6 6" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </aside>

  <script type="application/json" data-arbol-categorias set:html={JSON.stringify(arbol)} />
</div>
