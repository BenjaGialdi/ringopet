---
import type { Producto } from '../lib/tienda/tipos';

interface Props {
  productos: Producto[];
}

const { productos } = Astro.props;

const marcas = new Map<string, string>();
const pesos = new Map<string, string>();
const etapas = new Map<string, string>();

for (const p of productos) {
  if (p.brands[0]) marcas.set(p.brands[0].slug, p.brands[0].name);
  for (const attr of p.attributes) {
    if (attr.taxonomy === 'pa_peso') for (const t of attr.terms) pesos.set(t.slug, t.name);
    if (attr.taxonomy === 'pa_etapa-mascota') for (const t of attr.terms) etapas.set(t.slug, t.name);
  }
}

const listaMarcas = [...marcas.entries()].sort((a, b) => a[1].localeCompare(b[1]));
const listaPesos = [...pesos.entries()].sort((a, b) => a[1].localeCompare(b[1]));
const listaEtapas = [...etapas.entries()].sort((a, b) => a[1].localeCompare(b[1]));
---

<aside data-filtros class="w-full shrink-0 lg:w-64">
  <div class="flex items-center justify-between">
    <h2 class="text-lg">Filtros</h2>
    <button type="button" data-limpiar-filtros class="text-sm text-primario underline underline-offset-2">Limpiar</button>
  </div>

  {
    listaMarcas.length > 0 && (
      <details open class="mt-4 border-b border-borde pb-4">
        <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">Marca</summary>
        <ul class="mt-2 max-h-48 space-y-1 overflow-y-auto">
          {listaMarcas.map(([slug, nombre]) => (
            <li>
              <label class="flex min-h-9 cursor-pointer items-center gap-2 text-sm">
                <input type="checkbox" data-filtro-marca value={slug} class="h-4 w-4 accent-primario" />
                {nombre}
              </label>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    listaPesos.length > 0 && (
      <details open class="mt-4 border-b border-borde pb-4">
        <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">Peso</summary>
        <ul class="mt-2 flex flex-wrap gap-2">
          {listaPesos.map(([slug, nombre]) => (
            <li>
              <label class="flex min-h-9 cursor-pointer items-center gap-1 rounded-lg border border-borde px-2 text-sm has-checked:border-primario has-checked:text-primario">
                <input type="checkbox" data-filtro-peso value={slug} class="sr-only" />
                {nombre}
              </label>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    listaEtapas.length > 0 && (
      <details open class="mt-4 pb-4">
        <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">Etapa de la mascota</summary>
        <ul class="mt-2 space-y-1">
          {listaEtapas.map(([slug, nombre]) => (
            <li>
              <label class="flex min-h-9 cursor-pointer items-center gap-2 text-sm">
                <input type="checkbox" data-filtro-etapa value={slug} class="h-4 w-4 accent-primario" />
                {nombre}
              </label>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</aside>
