---
import { rutaLocal } from '../lib/tienda/productos';
import type { Producto } from '../lib/tienda/tipos';

interface Props {
  producto: Producto;
  prioridad?: boolean;
}

const { producto, prioridad = false } = Astro.props;
const ruta = rutaLocal(producto.permalink);
const imagen = producto.images[0];
const pesos = producto.attributes.find((a) => a.taxonomy === 'pa_peso');
const enOferta = producto.on_sale;
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-borde bg-fondo transition-shadow hover:shadow-lg" data-reveal>
  {enOferta && <span class="absolute left-3 top-3 z-10 rounded bg-primario px-2 py-1 text-xs font-bold text-sobre-primario">Oferta</span>}
  <a href={ruta} class="block overflow-hidden bg-fondo-suave">
    {
      imagen ? (
        <img
          src={imagen.src}
          srcset={imagen.srcset}
          sizes="(min-width: 1024px) 23vw, (min-width: 640px) 30vw, 45vw"
          alt={imagen.alt || producto.name}
          width="300"
          height="300"
          loading={prioridad ? 'eager' : 'lazy'}
          decoding="async"
          class="aspect-square w-full object-contain p-3 transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="aspect-square w-full" />
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-1 p-3">
    {pesos && <p class="flex flex-wrap gap-1 text-xs text-texto-suave">{pesos.terms.map((t) => t.name).join(' · ')}</p>}
    <h3 class="line-clamp-2 text-sm font-medium">
      <a href={ruta} class="after:absolute after:inset-0">{producto.name}</a>
    </h3>
    {producto.brands[0] && <p class="text-xs text-texto-suave">{producto.brands[0].name}</p>}
    <p class="mt-auto pt-1 font-semibold text-primario">
      {
        producto.prices.price_range
          ? `$ ${(Number(producto.prices.price_range.min_amount) / 10 ** producto.prices.currency_minor_unit).toLocaleString('es-AR')}`
          : `$ ${(Number(producto.prices.price) / 10 ** producto.prices.currency_minor_unit).toLocaleString('es-AR')}`
      }
    </p>
    <div class="relative z-10 mt-2">
      {
        producto.has_options ? (
          <a href={ruta} class="boton-borde block w-full py-2 text-center text-sm">Elegir opciones</a>
        ) : (
          <button type="button" data-agregar-carrito data-id={producto.id} class="boton w-full py-2 text-sm">
            Añadir al carrito
          </button>
        )
      }
    </div>
  </div>
</article>
