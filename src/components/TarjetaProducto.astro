---
/**
 * Tarjeta de producto para HTML generado en el build (portada, relacionados, primera tanda
 * de /tienda/ y categorías). La versión que arma el navegador (filtros, "mostrar más",
 * búsqueda) es src/scripts/tarjetas.ts — mismo diseño y mismos datos, pero ese vive del
 * lado del cliente y este del lado del build; no se pueden compartir como un solo archivo
 * .astro, así que se mantienen alineados a mano.
 */
import { rutaLocal } from '../lib/tienda/productos';
import { pesoEnKg, precioPorKg } from '../lib/tienda/precio-por-kg';
import type { Producto } from '../lib/tienda/tipos';

interface Props {
  producto: Producto;
  prioridad?: boolean;
}

const { producto, prioridad = false } = Astro.props;
const ruta = rutaLocal(producto.permalink);
const imagen = producto.images[0];
const atributoPeso = producto.attributes.find((a) => a.taxonomy === 'pa_peso');
const enOferta = producto.on_sale;
const unidad = 10 ** producto.prices.currency_minor_unit;

const precioCentavos = Number(producto.prices.price_range ? producto.prices.price_range.min_amount : producto.prices.price);
const regularCentavos = Number(producto.prices.regular_price || producto.prices.price);
const precioRegularCentavos = enOferta && regularCentavos > precioCentavos ? regularCentavos : null;

// Precio por kilo solo si hay un único peso reconocible (ver precio-por-kg.ts: nunca se inventa).
const unSoloPeso = atributoPeso?.terms.length === 1 ? atributoPeso.terms[0] : null;
const kg = unSoloPeso ? pesoEnKg(unSoloPeso.name) : null;
const porKgCentavos = precioPorKg(precioCentavos, kg);

const variantes =
  producto.type === 'variable' && atributoPeso
    ? producto.variations
        .map((v) => {
          const nombrePeso = v.attributes.find((a) => a.name.toLowerCase() === atributoPeso.name.toLowerCase())?.value;
          const termino = nombrePeso ? atributoPeso.terms.find((t) => t.name === nombrePeso) : null;
          return termino ? { id: v.id, pesoSlug: termino.slug, pesoNombre: termino.name } : null;
        })
        .filter((v): v is NonNullable<typeof v> => v !== null)
    : [];

const idInicial = variantes[0]?.id ?? producto.id;

function formatear(centavos: number) {
  return `$ ${(centavos / unidad).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-borde bg-fondo transition-shadow hover:shadow-lg" data-reveal data-tarjeta data-producto-id={producto.id}>
  {enOferta && <span class="absolute left-3 top-3 z-10 rounded bg-primario-oscuro px-2 py-1 text-xs font-bold text-sobre-primario">Oferta</span>}
  <a href={ruta} aria-label={producto.name} class="block overflow-hidden bg-fondo-suave">
    {
      imagen ? (
        <img
          src={imagen.src}
          srcset={imagen.srcset}
          sizes="(min-width: 1024px) 23vw, (min-width: 640px) 30vw, 45vw"
          alt={imagen.alt || producto.name}
          width="300"
          height="300"
          loading={prioridad ? 'eager' : 'lazy'}
          decoding="async"
          class="aspect-square w-full object-contain p-3 transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="aspect-square w-full" />
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-1 p-3">
    <h3 class="line-clamp-2 text-sm font-medium">
      <a href={ruta} class="after:absolute after:inset-0">{producto.name}</a>
    </h3>
    {producto.brands[0] && <p class="text-xs text-texto-suave">{producto.brands[0].name}</p>}
    <p class="mt-auto pt-1" data-precio-wrap>
      {precioRegularCentavos && <span class="mr-1.5 text-xs text-texto-suave line-through">{formatear(precioRegularCentavos)}</span>}
      <span class="font-semibold text-primario-oscuro" data-precio>{formatear(precioCentavos)}</span>
    </p>
    <p class="text-xs text-texto-suave" data-precio-kg hidden={!porKgCentavos}>{porKgCentavos ? `${formatear(porKgCentavos)}/kg` : ''}</p>
    {
      variantes.length > 0 && (
        <div class="relative z-10 mt-1 flex flex-wrap gap-1" data-selector-peso>
          {variantes.map((v, i) => (
            <button
              type="button"
              class:list={['rounded border px-1.5 py-0.5 text-xs', i === 0 ? 'border-primario text-primario-oscuro' : 'border-borde text-texto-suave']}
              data-variante-listado
              data-id={v.id}
              data-peso-slug={v.pesoSlug}
              aria-pressed={i === 0}
            >
              {v.pesoNombre}
            </button>
          ))}
        </div>
      )
    }
    <div class="relative z-10 mt-2">
      {
        producto.has_options && variantes.length === 0 ? (
          // Variable pero sin variar por peso (ej. sabor, color): no hay selector acá,
          // se elige en la ficha del producto, igual que antes.
          <a href={ruta} class="boton-borde block w-full py-2 text-center text-sm">Elegir opciones</a>
        ) : (
          <button type="button" data-agregar-carrito data-id={idInicial} class="boton w-full py-2 text-sm">Añadir al carrito</button>
        )
      }
    </div>
  </div>
</article>
