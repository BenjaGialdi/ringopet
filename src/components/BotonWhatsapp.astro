---
import { sitio } from '../config/sitio';
import { enlaceWhatsapp } from '../lib/url';
---

{
  sitio.whatsapp.botonFlotante && (
    <a
      href={enlaceWhatsapp()}
      target="_blank"
      rel="noopener"
      aria-label="Escribinos por WhatsApp"
      data-boton-whatsapp
      class="fixed z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition-transform duration-300 ease-out hover:scale-110"
      style="right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom));"
    >
      <svg viewBox="0 0 24 24" width="31" height="31" fill="#ffffff" aria-hidden="true" focusable="false">
        <path d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4a8.94 8.94 0 0 0-8.94 8.94 8.83 8.83 0 0 0 1.2 4.47L3 21l3.73-1.27a8.93 8.93 0 0 0 4.27 1.09h0A8.94 8.94 0 0 0 20 12.94a8.87 8.87 0 0 0-2.4-6.62zm-5.55 13.7h0a7.4 7.4 0 0 1-3.79-1l-.27-.16-2.77.94.94-2.7-.18-.28a7.4 7.4 0 0 1-1.13-3.94A7.42 7.42 0 0 1 12 5.56 7.36 7.36 0 0 1 17.42 8a7.34 7.34 0 0 1 2.16 5.23 7.42 7.42 0 0 1-7.53 7.29zm4.07-5.5c-.22-.11-1.31-.65-1.51-.72s-.35-.11-.5.11-.58.72-.71.87-.26.17-.48.06a6.06 6.06 0 0 1-1.78-1.1 6.7 6.7 0 0 1-1.23-1.53c-.13-.22 0-.34.1-.45s.22-.26.32-.39a1.48 1.48 0 0 0 .22-.36.4.4 0 0 0 0-.38c-.06-.11-.5-1.2-.68-1.64s-.36-.38-.5-.38-.28 0-.43 0a.83.83 0 0 0-.6.28 2.52 2.52 0 0 0-.79 1.88 4.39 4.39 0 0 0 .92 2.31 10 10 0 0 0 3.85 3.4 4.4 4.4 0 0 0 2.71.57 2.31 2.31 0 0 0 1.52-1.08 1.87 1.87 0 0 0 .13-1.08c-.04-.11-.2-.17-.42-.27z" />
      </svg>
    </a>
  )
}

<style>
  [data-boton-whatsapp] {
    animation: entrada-wa 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) 0.3s backwards, pulso-wa 2.6s ease-in-out 2s infinite;
  }
  @keyframes entrada-wa {
    from {
      opacity: 0;
      transform: scale(0.6) translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes pulso-wa {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
    }
    50% {
      box-shadow: 0 0 0 10px rgba(37, 211, 102, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-boton-whatsapp] {
      animation: none;
    }
  }
</style>
