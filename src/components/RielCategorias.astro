---
/**
 * Columna angosta fija a la izquierda, solo escritorio (ver CLAUDE.md, tanda 1 de la
 * revisión de diseño): un ícono por categoría principal, que al pasar el mouse despliega sus
 * subcategorías (src/components/MenuCategoriasArbol.astro, compartido con el desplegable
 * "Categorías" del encabezado).
 */
import { obtenerTodasLasCategorias, obtenerIconosCategorias, ordenarPrincipales, categoriasConStock } from '../lib/tienda/categorias';
import { obtenerProductosEnStock } from '../lib/tienda/productos';
import MenuCategoriasArbol from './MenuCategoriasArbol.astro';

const [categorias, productosEnStock, iconos] = await Promise.all([
  obtenerTodasLasCategorias(),
  obtenerProductosEnStock(),
  obtenerIconosCategorias(),
]);
const principales = ordenarPrincipales(categorias.filter((c) => c.parent === 0));
const conStock = categoriasConStock(categorias, productosEnStock);
---

<aside aria-label="Categorías" class="fixed inset-y-0 left-0 z-20 hidden w-16 border-r border-borde bg-fondo py-3 lg:block">
  <a
    href="/tienda/"
    aria-label="Ver todos los productos"
    class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primario text-sobre-primario shadow-sm transition-transform hover:scale-105"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </a>
  <MenuCategoriasArbol todas={categorias} items={principales} conStock={conStock} iconos={iconos} soloIcono />
</aside>
