---
import { Image } from 'astro:assets';
import { sitio } from '../config/sitio';
import { obtenerTodasLasCategorias, obtenerIconosCategorias, categoriasConStock, arbolCategoriasConStock, ordenarPrincipales } from '../lib/tienda/categorias';
import { obtenerProductosEnStock } from '../lib/tienda/productos';
import PanelCategorias from './PanelCategorias.astro';
import BarraInferiorMobile from './BarraInferiorMobile.astro';
import FilaMenuMobile from './FilaMenuMobile.astro';
import logo from '../assets/marca/logo.webp';

const [categorias, productosEnStock, iconos] = await Promise.all([
  obtenerTodasLasCategorias(),
  obtenerProductosEnStock(),
  obtenerIconosCategorias(),
]);
const principales = ordenarPrincipales(categorias.filter((c) => c.parent === 0));
const conStock = categoriasConStock(categorias, productosEnStock);
const arbol = arbolCategoriasConStock(categorias, principales, conStock, iconos);

const enlacesInfo = [
  { texto: 'Nosotros', ruta: '/nosotros/' },
  { texto: 'Contacto', ruta: '/contacto/' },
  { texto: 'Envíos y preguntas frecuentes', ruta: '/envios-y-preguntas-frecuentes/' },
  { texto: 'Mayorista', ruta: '/mayorista/' },
];
---

<PanelCategorias />

<header data-encabezado class="sticky top-0 z-10 border-b border-borde bg-fondo/95 backdrop-blur transition-shadow duration-300">
  <div class="contenedor flex items-center gap-3 py-3">
    <a href="/" class="shrink-0">
      <Image src={logo} alt={sitio.logo.alt} width={160} height={56} widths={[160, 320]} sizes="160px" priority class="aspect-[2048/714] h-14 w-auto" />
    </a>

    <button
      type="button"
      data-abrir-panel-categorias
      aria-haspopup="true"
      aria-expanded="false"
      class="hidden min-h-11 shrink-0 items-center gap-2 rounded-full bg-primario px-4 font-semibold text-sobre-primario transition-transform hover:scale-[1.03] md:flex"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      Categorías
    </button>

    <form data-form-busqueda-header action="/busqueda/" method="get" role="search" class="relative min-w-0 flex-1">
      <label for="buscar-header" class="sr-only">Buscar productos</label>
      <div class="flex items-center">
        <input
          id="buscar-header"
          type="search"
          name="q"
          autocomplete="off"
          placeholder="Buscar productos"
          class="min-h-11 w-full min-w-0 rounded-l-full border border-r-0 border-borde px-4 text-sm focus-visible:relative focus-visible:z-10"
        />
        <button type="submit" aria-label="Buscar" class="flex min-h-11 items-center justify-center rounded-r-full bg-primario px-4 text-sobre-primario">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
          </svg>
        </button>
      </div>

      <div
        data-panel-busqueda
        hidden
        class="max-md:fixed max-md:inset-0 max-md:z-50 max-md:flex max-md:h-dvh max-md:flex-col max-md:bg-fondo max-md:p-3 md:absolute md:left-0 md:top-full md:z-30 md:mt-2 md:w-full md:rounded-xl md:border md:border-borde md:bg-fondo md:p-2 md:shadow-xl"
      >
        <button type="button" data-cerrar-busqueda class="mb-2 flex min-h-11 items-center gap-2 self-start font-medium md:hidden">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="m15 18-6-6 6-6" />
          </svg>
          Volver
        </button>
        <div data-lista-busqueda class="flex-1 space-y-0.5 overflow-y-auto"></div>
        <a data-ver-todos-busqueda href="/busqueda/" class="mt-1 block rounded-lg p-2 text-center text-sm font-semibold text-primario-oscuro hover:bg-fondo-suave">
          Ver todos los resultados
        </a>
      </div>
    </form>

    <a href="/tienda/" class="hidden min-h-11 shrink-0 items-center gap-1.5 font-medium text-texto hover:text-primario md:flex">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M4 9l1-5h14l1 5M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9M4 9h16M9 13a2 2 0 1 0 4 0" />
      </svg>
      Productos
    </a>

    <div class="flex-1"></div>

    <a href={sitio.rutas.miCuenta} class="hidden min-h-11 shrink-0 items-center gap-2 font-medium text-texto hover:text-primario lg:flex">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
      </svg>
      <span data-etiqueta-sesion class="whitespace-nowrap">Iniciar sesión / Registrarse</span>
    </a>

    <button type="button" data-abrir-carrito aria-label="Ver carrito" class="relative hidden h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primario text-sobre-primario transition-transform hover:scale-[1.05] md:flex">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="9" cy="21" r="1" /><circle cx="19" cy="21" r="1" />
        <path d="M1 1h4l2.4 12.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 6H6" />
      </svg>
      <span data-contador-carrito hidden class="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full border-2 border-fondo bg-white px-1 text-[11px] font-bold text-primario-oscuro">0</span>
    </button>
  </div>
</header>

<BarraInferiorMobile />

<dialog data-menu-lateral aria-label="Menú" class="m-0 h-dvh max-h-none w-[85vw] max-w-[360px] border-none bg-fondo p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm open:animate-none">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-borde p-3">
      <form action="/busqueda/" method="get" role="search" class="flex min-w-0 flex-1 items-center">
        <label for="buscar-menu-mobile" class="sr-only">Buscar productos</label>
        <input id="buscar-menu-mobile" type="search" name="q" placeholder="Buscar productos" class="min-h-11 w-full min-w-0 rounded-l-full border border-r-0 border-borde px-4 text-sm" />
        <button type="submit" aria-label="Buscar" class="flex min-h-11 items-center justify-center rounded-r-full bg-primario px-4 text-sobre-primario">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
          </svg>
        </button>
      </form>
      <button type="button" data-cerrar-menu aria-label="Cerrar menú" class="ml-2 flex h-11 w-11 shrink-0 items-center justify-center rounded-full hover:bg-fondo-suave">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <div class="flex border-b border-borde" role="tablist">
      <button type="button" data-pestana-mm="categorias" role="tab" aria-selected="true" class="flex-1 border-b-2 border-primario py-3 text-center text-sm font-semibold tracking-wide text-primario-oscuro">
        CATEGORÍAS
      </button>
      <button type="button" data-pestana-mm="menu" role="tab" aria-selected="false" class="flex-1 border-b-2 border-transparent py-3 text-center text-sm font-semibold tracking-wide text-texto-suave">
        MENÚ
      </button>
    </div>

    <div class="flex-1 overflow-y-auto">
      <div data-panel-mm="categorias">
        {arbol.map((cat) => <FilaMenuMobile nodo={cat} />)}
      </div>
      <div data-panel-mm="menu" hidden>
        {
          enlacesInfo.map((e) => (
            <a href={e.ruta} class="flex h-[50px] items-center border-b border-borde px-3 text-texto hover:bg-fondo-suave">
              {e.texto}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</dialog>

<dialog data-carrito-lateral aria-label="Carrito de compra" class="m-0 h-dvh max-h-none w-[90vw] max-w-md border-none bg-fondo p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-borde p-4">
      <p class="font-titulos text-lg font-bold">Carrito de compra</p>
      <button type="button" data-cerrar-carrito aria-label="Cerrar carrito" class="flex h-9 w-9 items-center justify-center rounded-full hover:bg-fondo-suave">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4">
      <p data-carrito-vacio class="py-10 text-center text-texto-suave">Todavía no agregaste productos.</p>
      <ul data-carrito-items hidden class="divide-y divide-borde"></ul>
    </div>

    <div class="border-t border-borde p-4">
      <div class="flex items-center justify-between text-lg font-semibold">
        <span>Subtotal</span>
        <span data-carrito-subtotal class="text-primario-oscuro">$ 0,00</span>
      </div>
      <a href="/carrito/" class="boton-borde mt-4 w-full">Ver carrito</a>
      <a href={sitio.rutas.finalizarCompra} class="boton mt-3 w-full">Finalizar compra</a>
    </div>
  </div>
</dialog>

<dialog data-cuenta-lateral aria-label="Mi cuenta" class="m-0 h-dvh max-h-none w-[90vw] max-w-md border-none bg-fondo p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-borde p-4">
      <p class="font-titulos text-lg font-bold">Mi cuenta</p>
      <button type="button" data-cerrar-cuenta aria-label="Cerrar" class="flex h-9 w-9 items-center justify-center rounded-full hover:bg-fondo-suave">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4">
      <div data-cuenta-esqueleto class="animate-pulse space-y-4" aria-hidden="true">
        <div class="h-11 rounded-lg bg-fondo-suave"></div>
        <div class="h-11 rounded-lg bg-fondo-suave"></div>
        <div class="h-11 w-32 rounded-lg bg-fondo-suave"></div>
      </div>

      <form data-form-ingresar hidden class="space-y-4" novalidate>
        <div>
          <label for="cuenta-lateral-usuario" class="text-sm font-medium">Nombre de usuario o correo electrónico</label>
          <input id="cuenta-lateral-usuario" name="usuario" type="text" autocomplete="username" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
        </div>
        <div>
          <label for="cuenta-lateral-clave" class="text-sm font-medium">Contraseña</label>
          <input id="cuenta-lateral-clave" name="clave" type="password" autocomplete="current-password" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
        </div>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="recordarme" class="h-4 w-4 accent-primario" />
          Recordarme
        </label>
        <div data-ingresar-error aria-live="polite" class="text-sm text-primario-oscuro"></div>
        <button type="submit" data-boton-ingresar class="boton w-full disabled:cursor-not-allowed disabled:opacity-50">Iniciar sesión</button>
        <p class="text-center text-sm">
          <a href="/mi-cuenta/recuperar/" class="text-primario-oscuro underline underline-offset-2">¿Olvidaste tu contraseña?</a>
        </p>
      </form>

      <div data-panel-cuenta hidden>
        <p class="text-lg">Hola, <strong data-saludo-nombre></strong></p>

        <div class="mt-6" data-bloque-ultimos-pedidos hidden>
          <h2 class="text-lg">Tus últimos pedidos</h2>
          <ul data-ultimos-pedidos class="mt-2 divide-y divide-borde rounded-xl border border-borde"></ul>
        </div>

        <nav class="mt-6 grid gap-2" aria-label="Mi cuenta">
          <a href="/mi-cuenta/pedidos/" class="flex min-h-11 items-center rounded-lg border border-borde px-4 hover:bg-fondo-suave">Pedidos</a>
          <a href="/mi-cuenta/direcciones/" class="flex min-h-11 items-center rounded-lg border border-borde px-4 hover:bg-fondo-suave">Direcciones</a>
          <a href="/mi-cuenta/datos/" class="flex min-h-11 items-center rounded-lg border border-borde px-4 hover:bg-fondo-suave">Datos de la cuenta</a>
          <button type="button" data-boton-salir class="flex min-h-11 items-center rounded-lg border border-borde px-4 text-left hover:bg-fondo-suave">Cerrar sesión</button>
        </nav>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { iniciarCarritoUI } from '../scripts/carrito-ui';
  import { actualizarSesion } from '../lib/tienda/sesion-navegador';
  import { iniciarTarjetasInteractivas } from '../scripts/tarjetas';
  import { iniciarBusquedaHeader } from '../scripts/busqueda-header';
  import { iniciarEncabezadoUI } from '../scripts/encabezado-ui';
  import { iniciarPanelCategorias } from '../scripts/panel-categorias';
  import { iniciarMenuMobile } from '../scripts/menu-mobile';

  iniciarCarritoUI();
  // En segundo plano, no bloquea nada: deja el nonce de WordPress listo para cuando haga
  // falta (ver sesion-navegador.ts). Si falla o no hay sesión, el resto del sitio sigue igual.
  actualizarSesion();

  // Selector de peso de las tarjetas (portada, relacionados, listado, buscador del
  // encabezado): un solo listener delegado para todo el sitio, ver src/scripts/tarjetas.ts.
  // Moneda fija (ARS, $, 2 decimales) porque acá no hay ningún dato de producto a mano para
  // sacarla de ahí.
  iniciarTarjetasInteractivas({ decimales: 2, prefijo: '$ ', sufijo: '' });

  iniciarBusquedaHeader();
  iniciarEncabezadoUI();
  iniciarPanelCategorias();

  const menu = document.querySelector<HTMLDialogElement>('[data-menu-lateral]');
  if (menu) iniciarMenuMobile(menu);

  // Menú lateral (celular): abre/cierra como <dialog>, cierra con Escape (nativo) o clic afuera.
  menu?.addEventListener('close', () => {
    document.body.style.overflow = '';
  });
  menu?.querySelector('[data-cerrar-menu]')?.addEventListener('click', () => menu.close());
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) menu.close();
  });
  menu?.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => menu.close()));

  // Encabezado: gana sombra y fondo sólido al bajar.
  const encabezado = document.querySelector('[data-encabezado]');
  const alScrollear = () => encabezado?.classList.toggle('shadow-md', window.scrollY > 8);
  addEventListener('scroll', alScrollear, { passive: true });
  alScrollear();
</script>
