---
import Base from '../layouts/Base.astro';
import { sitio } from '../config/sitio';

const t = sitio.textos.noEncontrada;
---

<Base titulo={t.titulo} noindex>
  <section class="contenedor py-16 text-center">
    <p class="text-6xl font-bold text-primario-oscuro" aria-hidden="true">404</p>
    <h1 class="mt-2 text-4xl">{t.titulo}</h1>
    <p class="mx-auto mt-4 max-w-xl text-xl text-texto-suave">{t.mensaje}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="boton">Ir al inicio</a>
      <a href="/contacto/" class="boton-borde">Contacto</a>
    </div>
  </section>
</Base>
