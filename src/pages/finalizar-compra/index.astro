---
import Base from '../../layouts/Base.astro';

// PENDIENTE (regla "Astro solo lee de Woo", ver CLAUDE.md): esta lista se relevó
// del HTML del checkout clásico de WooCommerce, pero no encontré de dónde la arma
// (no es un ajuste nativo de WooCommerce ni aparece en ningún plugin con API
// pública instalado en el sitio: probablemente esté escrita a mano en el tema o
// en un plugin de edición de campos del checkout). Avisame dónde está cargada de
// verdad y armo un endpoint de solo lectura como los de wp-plugin/, igual que se
// hizo con las cuentas bancarias y los medios de pago.
const localidades = [
  { valor: 'Córdoba', texto: 'Córdoba capital (incluye Argüello, Valle Escondido y V. Belgrano)' },
  { valor: 'La Calera', texto: 'La Calera' },
  { valor: 'Saldán', texto: 'Saldán' },
  { valor: 'Villa Allende', texto: 'Villa Allende' },
  { valor: 'Mendiolaza', texto: 'Mendiolaza' },
  { valor: 'Unquillo', texto: 'Unquillo' },
  { valor: 'Río Ceballos', texto: 'Río Ceballos' },
];
---

<Base titulo="Finalizar compra" noindex>
  <section class="contenedor py-8">
    <h1 class="text-3xl sm:text-4xl">Finalizar compra</h1>

    <p data-checkout-vacio class="py-16 text-center text-texto-suave" hidden>
      Tu carrito está vacío. <a href="/" class="text-primario-oscuro underline underline-offset-2">Ver productos</a>
    </p>

    <form data-form-checkout data-checkout-form hidden class="mt-6 lg:grid lg:grid-cols-[1fr_380px] lg:items-start lg:gap-8" novalidate>
      <!-- Resumen en celular: plegado arriba del formulario, mostrando el total. -->
      <details class="mb-6 rounded-xl border border-borde lg:hidden" data-resumen-instancia>
        <summary class="flex min-h-11 cursor-pointer items-center justify-between p-4 font-semibold marker:content-none">
          <span>Ver resumen del pedido</span>
          <span data-resumen-total-resumido>$ 0,00</span>
        </summary>
        <div class="border-t border-borde p-4" data-resumen-cuerpo>
          <ul data-resumen-items class="divide-y divide-borde"></ul>
          <dl class="mt-3 space-y-2 border-t border-borde pt-3 text-sm">
            <div class="flex justify-between"><dt>Subtotal</dt><dd data-resumen-subtotal>$ 0,00</dd></div>
            <div class="flex justify-between" data-resumen-fila-descuento hidden><dt>Descuento</dt><dd data-resumen-descuento class="text-primario-oscuro">$ 0,00</dd></div>
            <ul data-resumen-fees class="contents"></ul>
            <div class="flex justify-between" data-resumen-fila-envio hidden><dt>Envío</dt><dd data-resumen-envio></dd></div>
            <div class="flex justify-between text-base font-semibold text-texto"><dt>Total</dt><dd data-resumen-total>$ 0,00</dd></div>
          </dl>
        </div>
      </details>

      <div class="space-y-8">
        <section>
          <h2 class="text-xl">Tus datos</h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div data-campo="first_name">
              <label for="first_name" class="text-sm font-medium">Nombre *</label>
              <input id="first_name" name="first_name" type="text" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
            <div data-campo="last_name">
              <label for="last_name" class="text-sm font-medium">Apellido *</label>
              <input id="last_name" name="last_name" type="text" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
            <div data-campo="phone">
              <label for="phone" class="text-sm font-medium">Teléfono *</label>
              <input id="phone" name="phone" type="tel" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
            <div data-campo="email">
              <label for="email" class="text-sm font-medium">Correo electrónico *</label>
              <input id="email" name="email" type="email" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
          </div>
        </section>

        <section>
          <h2 class="text-xl">Entrega</h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2" data-campo="address_1">
              <label for="address_1" class="text-sm font-medium">Calle y número *</label>
              <input id="address_1" name="address_1" type="text" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
            <div data-campo="address_2">
              <label for="address_2" class="text-sm font-medium">Piso, depto o barrio cerrado (opcional)</label>
              <input id="address_2" name="address_2" type="text" class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
            <div data-campo="city">
              <label for="city" class="text-sm font-medium">Localidad *</label>
              <select id="city" name="city" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3">
                <option value="">Elegí tu localidad</option>
                {localidades.map((loc) => <option value={loc.valor}>{loc.texto}</option>)}
              </select>
            </div>
            <div data-campo="postcode">
              <label for="postcode" class="text-sm font-medium">Código postal *</label>
              <input id="postcode" name="postcode" type="text" required class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
            </div>
          </div>
        </section>

        <section>
          <h2 class="text-xl">Entrega programada</h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div data-campo="fecha">
              <label for="fecha-entrega" class="text-sm font-medium">Fecha de entrega *</label>
              <input id="fecha-entrega" data-input-fecha type="text" placeholder="Elegí una fecha" readonly required class="mt-1 min-h-11 w-full rounded-lg border border-borde bg-fondo px-3" />
            </div>
            <div data-campo="turno">
              <label for="turno-entrega" class="text-sm font-medium">Turno de entrega *</label>
              <select id="turno-entrega" data-select-turno required disabled class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3 disabled:bg-fondo-suave disabled:text-texto-suave">
                <option value="">Elegí un turno</option>
              </select>
            </div>
          </div>
          <p data-nota-entrega class="mt-3 text-sm text-texto-suave"></p>
        </section>

        <section>
          <label for="notas" class="text-xl">Notas del pedido (opcional)</label>
          <textarea id="notas" name="customer_note" rows="3" class="mt-3 w-full rounded-lg border border-borde px-3 py-2"></textarea>
        </section>

        <section>
          <h2 class="text-xl">Medio de pago</h2>
          <div data-medios-pago class="mt-3 space-y-2"></div>
        </section>

        <div data-checkout-errores aria-live="polite" class="space-y-2"></div>

        <button type="submit" data-boton-pagar class="boton w-full disabled:cursor-not-allowed disabled:opacity-50 lg:hidden">Pagar pedido</button>
      </div>

      <aside class="hidden h-fit space-y-5 rounded-xl border border-borde p-5 lg:sticky lg:top-24 lg:block" data-resumen-instancia>
        <div data-resumen-cuerpo>
          <h2 class="text-lg">Tu pedido</h2>
          <ul data-resumen-items class="mt-2 divide-y divide-borde"></ul>
          <dl class="mt-2 space-y-2 border-t border-borde pt-2 text-sm">
            <div class="flex justify-between"><dt>Subtotal</dt><dd data-resumen-subtotal>$ 0,00</dd></div>
            <div class="flex justify-between" data-resumen-fila-descuento hidden><dt>Descuento</dt><dd data-resumen-descuento class="text-primario-oscuro">$ 0,00</dd></div>
            <ul data-resumen-fees class="contents"></ul>
            <div class="flex justify-between" data-resumen-fila-envio hidden><dt>Envío</dt><dd data-resumen-envio></dd></div>
            <div class="flex justify-between text-base font-semibold text-texto"><dt>Total</dt><dd data-resumen-total>$ 0,00</dd></div>
          </dl>
        </div>

        <button type="submit" data-boton-pagar-escritorio class="boton w-full disabled:cursor-not-allowed disabled:opacity-50">Pagar pedido</button>
      </aside>
    </form>
  </section>
</Base>

<script>
  import { iniciarPaginaCheckout } from '../../scripts/pagina-checkout';
  iniciarPaginaCheckout();
</script>
