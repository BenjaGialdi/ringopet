---
import Base from '../../layouts/Base.astro';
import PasosCompra from '../../components/PasosCompra.astro';
---

<Base titulo="Carrito de compra" noindex>
  <PasosCompra paso={1} />
  <section class="contenedor py-8" data-pagina-carrito>
    <h1 class="text-3xl sm:text-4xl">Carrito de compra</h1>

    <p data-aviso-mp hidden class="mt-4 rounded-lg bg-fondo-suave p-3 text-sm" role="status"></p>

    <div data-carrito-esqueleto class="mt-6 grid animate-pulse gap-8 lg:grid-cols-[1fr_360px]" aria-hidden="true">
      <ul class="divide-y divide-borde">
        {[1, 2].map(() => (
          <li class="flex gap-4 py-5">
            <div class="h-20 w-20 shrink-0 rounded-lg bg-fondo-suave sm:h-24 sm:w-24" />
            <div class="flex-1 space-y-2">
              <div class="h-4 w-2/3 rounded bg-fondo-suave" />
              <div class="h-3 w-1/3 rounded bg-fondo-suave" />
              <div class="h-8 w-24 rounded bg-fondo-suave" />
            </div>
          </li>
        ))}
      </ul>
      <div class="h-56 rounded-xl bg-fondo-suave" />
    </div>

    <p data-carrito-vacio class="py-16 text-center text-texto-suave" hidden>
      Todavía no agregaste productos. <a href="/" class="text-primario-oscuro underline underline-offset-2">Seguir comprando</a>
    </p>

    <div data-carrito-contenido hidden class="mt-6 grid gap-8 lg:grid-cols-[1fr_360px]">
      <div>
        <div data-carrito-errores class="mb-4 space-y-2" aria-live="polite"></div>
        <ul data-carrito-items class="divide-y divide-borde"></ul>
      </div>

      <aside class="h-fit rounded-xl border border-borde p-5">
        <form data-form-cupon class="flex gap-2">
          <label for="cupon" class="sr-only">Código de cupón</label>
          <input id="cupon" type="text" placeholder="Código de cupón" class="min-h-11 flex-1 rounded-lg border border-borde px-3" />
          <button type="submit" class="boton-borde px-4">Aplicar</button>
        </form>
        <ul data-carrito-cupones class="mt-3 space-y-1 text-sm"></ul>

        <dl class="mt-4 space-y-2 border-t border-borde pt-4 text-sm">
          <div class="flex justify-between">
            <dt>Subtotal</dt>
            <dd data-carrito-subtotal>$ 0,00</dd>
          </div>
          <div class="flex justify-between" data-fila-descuento hidden>
            <dt>Descuento</dt>
            <dd data-carrito-descuento class="text-primario-oscuro">$ 0,00</dd>
          </div>
          <ul data-carrito-fees class="contents"></ul>
          <div class="flex justify-between" data-fila-envio hidden>
            <dt>Envío</dt>
            <dd data-carrito-envio></dd>
          </div>
          <div class="flex justify-between text-base font-semibold text-texto">
            <dt>Total</dt>
            <dd data-carrito-total>$ 0,00</dd>
          </div>
        </dl>

        <a data-boton-finalizar href="/finalizar-compra/" class="boton mt-4 w-full">Finalizar compra</a>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { iniciarPaginaCarrito } from '../../scripts/pagina-carrito';
  iniciarPaginaCarrito();
</script>
