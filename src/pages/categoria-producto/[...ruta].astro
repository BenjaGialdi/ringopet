---
import Base from '../../layouts/Base.astro';
import ListadoProductos from '../../components/ListadoProductos.astro';
import { obtenerTodasLasCategorias, rutaLocal, cadenaDeCategorias } from '../../lib/tienda/categorias';
import { obtenerProductosParaListado } from '../../lib/tienda/productos';
import type { Categoria } from '../../lib/tienda/tipos';

export async function getStaticPaths() {
  const categorias = await obtenerTodasLasCategorias();
  return categorias.map((categoria) => {
    const ruta = rutaLocal(categoria.permalink).replace(/^\/categoria-producto\//, '').replace(/\/$/, '');
    return { params: { ruta }, props: { categoria } };
  });
}

interface Props {
  categoria: Categoria;
}

const LOTE = 24;
const { categoria } = Astro.props;
const [todas, productos] = await Promise.all([obtenerTodasLasCategorias(), obtenerProductosParaListado(categoria.id)]);
const migas = cadenaDeCategorias(todas, categoria).map((c) => ({ nombre: c.name, ruta: rutaLocal(c.permalink) }));
---

<Base titulo={categoria.name} descripcion={categoria.description.replace(/<[^>]+>/g, '') || undefined} migas={migas}>
  <ListadoProductos titulo={categoria.name} categoriaInicialSlug={categoria.slug} productosSsr={productos.slice(0, LOTE)} totalSsr={productos.length} />
</Base>

<script>
  import { iniciarListadoProductos } from '../../scripts/listado-productos';
  iniciarListadoProductos();
</script>
