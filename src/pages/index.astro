---
import Base from '../layouts/Base.astro';
import CarruselProductos from '../components/CarruselProductos.astro';
import { sitio } from '../config/sitio';
import { obtenerTodasLasCategorias, rutaLocal as rutaCategoria, ordenarPrincipales } from '../lib/tienda/categorias';
import { obtenerEnOferta, obtenerMasPedidos } from '../lib/tienda/productos';

const [categorias, enOferta, masPedidos] = await Promise.all([
  obtenerTodasLasCategorias(),
  obtenerEnOferta(12),
  obtenerMasPedidos(12),
]);
const principales = ordenarPrincipales(categorias.filter((c) => c.parent === 0));
const t = sitio.textos.inicio;
---

<Base>
  <section class="contenedor py-8 sm:py-12" data-reveal>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col justify-center rounded-2xl bg-fondo-suave p-8 sm:col-span-2 lg:col-span-1">
        <h1 class="text-3xl sm:text-4xl">Todo lo que tu mascota necesita, en un solo lugar</h1>
        <p class="mt-3 text-lg text-texto-suave">Alimento balanceado y productos para mascotas en Córdoba capital, con entrega programada.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/categoria-producto/perros/" class="boton">Ver perros</a>
          <a href="/categoria-producto/gatos/" class="boton-borde">Ver gatos</a>
        </div>
      </div>
      {
        principales.slice(0, 2).map((c, i) => (
          <a href={rutaCategoria(c.permalink)} class="group relative flex aspect-[4/3] items-end overflow-hidden rounded-2xl bg-fondo-suave sm:aspect-auto">
            {c.image && (
              <img
                src={c.image.src}
                alt={c.image.alt || c.name}
                loading="eager"
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            )}
            <span class="relative z-10 m-4 rounded-lg bg-fondo/90 px-4 py-2 font-semibold">{c.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-borde bg-fondo-suave py-4" data-reveal>
    <ul class="contenedor flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm font-medium text-texto-suave">
      {
        sitio.beneficios.map((b) => (
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-primario" aria-hidden="true" />
            {b.titulo}
          </li>
        ))
      }
    </ul>
  </section>

  <CarruselProductos titulo={t.destacadosTitulo} productos={masPedidos} />
  <CarruselProductos titulo={t.liquidacionTitulo} productos={enOferta} verTodoRuta="/busqueda/?oferta=1" />

  <section class="contenedor py-10" data-reveal>
    <h2 class="text-2xl sm:text-3xl">{t.categoriasTitulo}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        principales.map((c) => (
          <a href={rutaCategoria(c.permalink)} class="group flex items-center gap-4 rounded-xl border border-borde p-4 transition-shadow hover:shadow-md">
            {c.image && (
              <img src={c.image.src} alt="" loading="lazy" decoding="async" width="56" height="56" class="h-14 w-14 shrink-0 rounded-full object-cover" />
            )}
            <div>
              <p class="font-semibold group-hover:text-primario">{c.name}</p>
              <p class="text-sm text-texto-suave">{c.count} productos</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="contenedor py-10" data-reveal>
    <h2 class="text-2xl sm:text-3xl">Cómo funciona la entrega</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-borde p-4"><p class="font-semibold">1. Hacé tu pedido</p><p class="mt-1 text-sm text-texto-suave">Elegí el día y el turno de entrega al finalizar la compra.</p></div>
      <div class="rounded-xl border border-borde p-4"><p class="font-semibold">2. Recibí la confirmación</p><p class="mt-1 text-sm text-texto-suave">Te llega por email apenas confirmamos el pedido.</p></div>
      <div class="rounded-xl border border-borde p-4"><p class="font-semibold">3. Esperá que llegue</p><p class="mt-1 text-sm text-texto-suave">Repartimos por toda Córdoba capital, dentro de circunvalación.</p></div>
      <div class="rounded-xl border border-borde p-4"><p class="font-semibold">4. Recibilo en tu casa</p><p class="mt-1 text-sm text-texto-suave">En el turno que elegiste, sin sorpresas.</p></div>
    </div>
  </section>
</Base>
