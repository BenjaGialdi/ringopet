---
import Base from '../../../layouts/Base.astro';
---

<Base titulo="Detalle del pedido" noindex migas={[{ nombre: 'Mi cuenta', ruta: '/mi-cuenta/' }, { nombre: 'Pedidos', ruta: '/mi-cuenta/pedidos/' }, { nombre: 'Detalle', ruta: '/mi-cuenta/pedido/' }]}>
  <section class="contenedor max-w-2xl py-8">
    <div data-pedido-esqueleto class="animate-pulse space-y-4" aria-hidden="true">
      <div class="h-8 w-48 rounded bg-fondo-suave"></div>
      <div class="h-40 rounded-xl bg-fondo-suave"></div>
    </div>

    <div data-pedido-error hidden class="py-16 text-center">
      <h1 class="text-3xl">No encontramos ese pedido</h1>
      <p class="mt-3 text-texto-suave">Puede que no exista o que no sea tuyo.</p>
      <a href="/mi-cuenta/pedidos/" class="boton mt-6 inline-block">Ver mis pedidos</a>
    </div>

    <div data-pedido-contenido hidden>
      <h1 class="text-3xl sm:text-4xl">Pedido <span data-numero></span></h1>
      <p class="mt-1 text-texto-suave"><span data-fecha></span> · <span data-estado></span></p>

      <div data-linea-estado class="mt-4"></div>

      <div data-entrega hidden class="mt-6 rounded-xl border border-borde p-5">
        <p><span data-etiqueta-fecha class="font-medium"></span>: <span data-valor-fecha></span></p>
        <p class="mt-1"><span data-etiqueta-turno class="font-medium"></span>: <span data-valor-turno></span></p>
      </div>

      <div class="mt-6 rounded-xl border border-borde p-5">
        <ul data-items class="divide-y divide-borde"></ul>
        <div class="mt-3 flex justify-between border-t border-borde pt-3 text-sm">
          <span>Subtotal</span>
          <span data-subtotal></span>
        </div>
        <div class="mt-1 flex justify-between text-lg font-semibold">
          <span>Total</span>
          <span data-total></span>
        </div>
        <p class="mt-2 text-sm text-texto-suave">Medio de pago: <span data-metodo-pago></span></p>
      </div>

      <div data-transferencia hidden class="mt-6 rounded-xl border-2 border-primario bg-fondo-suave p-5">
        <h2 class="text-lg">Datos para transferir</h2>
        <dl class="mt-2 space-y-1 text-sm">
          <div><dt class="inline font-medium">Titular:</dt> <dd class="inline" data-titular></dd></div>
          <div><dt class="inline font-medium">CVU:</dt> <dd class="inline" data-cvu></dd></div>
          <div><dt class="inline font-medium">Alias:</dt> <dd class="inline" data-alias></dd></div>
        </dl>
      </div>

      <a href="/mi-cuenta/pedidos/" class="mt-8 inline-block text-primario-oscuro underline underline-offset-2">Volver a mis pedidos</a>
    </div>
  </section>
</Base>

<script>
  import { iniciarPaginaDetallePedido } from '../../../scripts/cuenta-pedido';
  iniciarPaginaDetallePedido();
</script>
