---
import Base from '../../../layouts/Base.astro';
---

<!--
  Esta carpeta existe para interceptar el endpoint nativo de Mi cuenta de WooCommerce
  (Ajustes > Avanzado > Endpoints de cuenta > "Contraseña perdida", slug real verificado
  en prueba.ringopet.com.ar: /mi-cuenta/lost-password/). Ahí caen los enlaces de los
  emails de WooCommerce/WordPress para elegir contraseña (cuenta nueva creada desde el
  pago) y para recuperar una contraseña (?key=...&login=...): esta página los redirige a
  /mi-cuenta/nueva-clave/ conservando esos dos parámetros. /mi-cuenta/ también detecta
  estos parámetros como respaldo, por si algún enlace viejo apunta ahí directo.
-->
<Base titulo="Contraseña perdida" noindex>
  <section class="contenedor max-w-sm py-16 text-center text-texto-suave">
    <p>Redirigiendo...</p>
  </section>
</Base>

<script>
  const parametros = new URLSearchParams(location.search);
  const key = parametros.get('key');
  const login = parametros.get('login');
  // El email de recuperación de WooCommerce manda ?key=&id= (id del usuario); el de cuenta nueva, ?key=&login=.
  const id = parametros.get('id');
  const quien = login ? `login=${encodeURIComponent(login)}` : id ? `id=${encodeURIComponent(id)}` : '';
  location.replace(key && quien ? `/mi-cuenta/nueva-clave/?key=${encodeURIComponent(key)}&${quien}` : '/mi-cuenta/recuperar/');
</script>
