---
import Base from '../../../layouts/Base.astro';
---

<Base titulo="Elegir contraseña nueva" noindex>
  <section class="contenedor max-w-sm py-8">
    <h1 class="text-3xl sm:text-4xl">Elegí tu contraseña</h1>

    <div data-clave-error-enlace hidden class="mt-6 py-8 text-center">
      <p class="text-texto-suave">El enlace no es válido o le falta información. Pedí uno nuevo.</p>
      <a href="/mi-cuenta/recuperar/" class="boton mt-6 inline-block">Pedir un enlace nuevo</a>
    </div>

    <form data-form-nueva-clave class="mt-6 space-y-4" novalidate>
      <div>
        <label for="clave" class="text-sm font-medium">Contraseña nueva</label>
        <input id="clave" name="clave" type="password" autocomplete="new-password" required minlength="6" class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
      </div>
      <div>
        <label for="clave_confirmar" class="text-sm font-medium">Repetí la contraseña</label>
        <input id="clave_confirmar" name="clave_confirmar" type="password" autocomplete="new-password" required minlength="6" class="mt-1 min-h-11 w-full rounded-lg border border-borde px-3" />
      </div>
      <div data-clave-error aria-live="polite" class="text-sm text-primario-oscuro"></div>
      <button type="submit" data-boton-guardar class="boton w-full disabled:cursor-not-allowed disabled:opacity-50">Guardar contraseña</button>
    </form>

    <div data-clave-ok hidden class="mt-6 py-8 text-center">
      <p class="text-texto-suave">Listo, ya podés iniciar sesión con tu contraseña nueva.</p>
      <a href="/mi-cuenta/" class="boton mt-6 inline-block">Ir a Mi cuenta</a>
    </div>
  </section>
</Base>

<script>
  import { iniciarPaginaNuevaClave } from '../../../scripts/cuenta-nueva-clave';
  iniciarPaginaNuevaClave();
</script>
